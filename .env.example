# Variables de entorno — CRM de Productividad Hello Minus
# Copiar a .env (frontend) / .env del backend y completar. .env está en .gitignore.

# --- Supabase (proyecto crm-productividad-hello-minus) ---
# El frontend usa la publishable key; nunca la service_role.
VITE_SUPABASE_URL=https://qutqsyokdlitflybfrus.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_NpCz6Adh12Djjad1E2Y2mA_MuRzjMi1

# --- Backend (Node + Express) — va en backend/api/.env ---
PORT=3001
SUPABASE_URL=https://qutqsyokdlitflybfrus.supabase.co
SUPABASE_ANON_KEY=sb_publishable_NpCz6Adh12Djjad1E2Y2mA_MuRzjMi1
# service_role: solo backend y agentes de ingesta. Salta RLS — jamás en el
# frontend ni en el repo. Se obtiene del dashboard de Supabase (Settings > API).
SUPABASE_SERVICE_ROLE_KEY=

# CORS: orígenes permitidos, separados por coma. Nunca "*".
CORS_ORIGINS=http://localhost:5173

# --- Claude (features conversacionales / evaluación) ---
ANTHROPIC_API_KEY=
