# Variables de entorno — CRM de Productividad Hello Minus
# Copiar a .env (frontend) / .env del backend y completar. .env está en .gitignore.

# --- Supabase (proyecto crm-productividad-hello-minus) ---
# El frontend usa la publishable key; nunca la service_role.
VITE_SUPABASE_URL=https://qutqsyokdlitflybfrus.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_NpCz6Adh12Djjad1E2Y2mA_MuRzjMi1
# URL de backend/api/ corriendo local (ver más abajo) o desplegado.
VITE_API_URL=http://localhost:3001

# --- Backend (Node + Express) — va en backend/api/.env ---
PORT=3001
SUPABASE_URL=https://qutqsyokdlitflybfrus.supabase.co
SUPABASE_ANON_KEY=sb_publishable_NpCz6Adh12Djjad1E2Y2mA_MuRzjMi1
# service_role: salta RLS — jamás en el frontend ni en el repo. Se obtiene del
# dashboard de Supabase (Settings > API). Ojo: la API de Express NO la usa ni
# la valida (ver backend/api/config.ts) — queda acá para los agentes de
# ingesta, que sí la necesitan. Dejarla vacía no impide que la API arranque.
SUPABASE_SERVICE_ROLE_KEY=

# CORS: orígenes permitidos, separados por coma. Nunca "*".
CORS_ORIGINS=http://localhost:5173

# Token de GitHub, solo lectura. En teoría opcional; en la práctica hace falta:
# sin él son 60 peticiones/hora por IP y la tabla de "Descubiertos" gasta 12
# cada vez que se carga. Con token son 5000/hora, y además se ven los repos
# privados propios.
GITHUB_TOKEN=

# La hereda el proceso Python del Sugeridor de etapa (backend/agent/), que la
# API lanza como proceso hijo cuando alguien aprieta "Sugerir" al vincular un
# repo. Sin ella la API arranca igual: el botón responde que falta y la etapa
# se elige a mano.
ANTHROPIC_API_KEY=

# --- Agentes Python (backend/agent/) ---
# El Clasificador de commits corre por GitHub Actions y toma su clave de los
# secretos del repo, no de acá. El Sugeridor de etapa, en cambio, lo lanza la
# API: su clave es la ANTHROPIC_API_KEY de arriba, heredada del entorno.
